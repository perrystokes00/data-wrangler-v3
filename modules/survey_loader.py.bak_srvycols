"""
modules/survey_loader.py
========================
Format-agnostic directional-survey loader.

A directional survey is the SAME thing regardless of the file it came from:
a header (one well, a survey type, a depth span) plus an ordered list of
stations (MD / INC / AZI / TVD / ...). Only the *extraction* differs by
format — PDF, Word, Excel, WITSML each have their own reader. The *loading*
is identical, so it lives here, once, and every format calls it.

    pdf_survey_catalog.extract_stations(pdf)   ─┐
    word_survey.extract_stations(docx)          ─┤   neutral stations
    excel_survey.extract_stations(xlsx)         ─┼─►  + well_info ──► load_directional_survey()
    witsml_survey.extract_stations(xml)         ─┘                        │
                                                                          ▼
                                          capture() ──► file_catalog.cat_well_dir_srvy_hdr
                                                        file_catalog.cat_well_dir_srvy_sta

Dependency direction: format modules import THIS; this imports nothing
format-specific. No survey extractor depends on another format's module.

────────────────────────────────────────────────────────────────────────────
THE NEUTRAL CONTRACT  (what every format extractor must produce)
────────────────────────────────────────────────────────────────────────────
well_info : dict
    uwi           : str   (required — the well key; rows are keyed by it)
    well_name     : str   (optional)
    survey_type   : str   (optional, default 'MWD' — e.g. MWD / GYRO / TOTCO)
    inventory_id  : str   (optional — file provenance; enables idempotent re-load)
    source_path   : str   (optional — file path for provenance)

stations : list[dict], each with any of these canonical keys (all optional
           except MD; missing keys load as NULL):
    MD   : float  measured depth          (required to be a usable station)
    INC  : float  inclination, degrees
    AZI  : float  azimuth, degrees
    TVD  : float  true vertical depth
    NS   : float  north/south deviation
    EW   : float  east/west deviation
    DLS  : float  dogleg severity

A format reader that already has differently-named columns should map them to
these keys before calling — or use normalize_stations() below, which accepts
common aliases (md/measured_depth, inc/inclination, azi/azimuth, ...).
"""
from __future__ import annotations

import uuid
from datetime import datetime

# Resilient import: works whether catalog_capture lands in modules/ or root.
try:
    from modules.catalog_capture import capture
except ImportError:
    from catalog_capture import capture


HDR_TABLE = "cat_well_dir_srvy_hdr"
STA_TABLE = "cat_well_dir_srvy_sta"


# ── helpers ──────────────────────────────────────────────────────────────────
def _uid() -> str:
    return uuid.uuid4().hex[:40].upper()


def _ts() -> str:
    return datetime.now().strftime("%Y-%m-%d %H:%M:%S")


def _trunc(v, n=40):
    return str(v)[:n] if v is not None else None


def _f(v):
    """Best-effort float; tolerant of commas / stray text. None on failure."""
    if v is None:
        return None
    try:
        return float(str(v).replace(",", "").strip())
    except (ValueError, TypeError):
        return None


def _result(loaded=0, errors=None, **ids):
    return {"ok": not errors, "loaded": loaded,
            "errors": errors or [], "ids": ids}


# Common column aliases → canonical station keys. Lets a Word/Excel/WITSML
# reader pass through near-raw rows without each one re-implementing mapping.
_ALIASES = {
    "MD": "MD", "MEASURED_DEPTH": "MD", "DEPTH": "MD", "MEASUREDDEPTH": "MD",
    "INC": "INC", "INCL": "INC", "INCLINATION": "INC", "INC_DEG": "INC",
    "AZI": "AZI", "AZIM": "AZI", "AZIMUTH": "AZI", "AZI_DEG": "AZI",
    "TVD": "TVD", "TRUE_VERTICAL_DEPTH": "TVD", "TVDSS": "TVD",
    "NS": "NS", "NORTH_SOUTH": "NS", "N_S": "NS", "NORTHING": "NS",
    "EW": "EW", "EAST_WEST": "EW", "E_W": "EW", "EASTING": "EW",
    "DLS": "DLS", "DOGLEG": "DLS", "DOGLEG_SEVERITY": "DLS", "DOG_LEG": "DLS",
}


def normalize_stations(raw_rows) -> list[dict]:
    """Map arbitrarily-named station rows to canonical MD/INC/AZI/... keys.

    Each input row is a dict; keys are matched case-insensitively against the
    alias table. Unknown keys are dropped. Use this in a format reader when the
    source columns don't already match the canonical names exactly.
    """
    out = []
    for r in (raw_rows or []):
        if not r:
            continue
        std = {}
        for k, v in r.items():
            canon = _ALIASES.get(str(k).strip().upper())
            if canon and canon not in std:
                std[canon] = v
        if std.get("MD") is not None:
            out.append(std)
    return out


# ── the loader ───────────────────────────────────────────────────────────────
def load_directional_survey(engine, well_info: dict, stations: list[dict],
                            *, dialect: str = "mssql",
                            source: str = "DATA_LOADER") -> dict:
    """Write a directional survey to the cat_* mirrors. Format-agnostic.

    header  → file_catalog.cat_well_dir_srvy_hdr  (one row)
    stations→ file_catalog.cat_well_dir_srvy_sta  (one row per station)

    capture() introspects each mirror's real columns and keeps only matching
    keys (case-insensitive), so the canonical field names below adapt to
    whatever the cat_well_dir_srvy_* tables actually define; unknown keys are
    dropped with a one-time warning rather than erroring. promote_catalog lifts
    these into dataview.dv_well_dir_srvy_* later.

    Returns {"ok", "loaded", "errors", "ids": {"survey_id": ...}}.
    """
    uwi = _trunc((well_info or {}).get("uwi"), 40)
    if not uwi:
        return _result(errors=["No UWI provided"])
    stations = [s for s in (stations or []) if s and s.get("MD") is not None]
    if not stations:
        return _result(errors=["No stations to load"])

    inv  = (well_info or {}).get("inventory_id")
    sp   = (well_info or {}).get("source_path")
    ts   = _ts()
    sid  = _uid()
    styp = _trunc((well_info or {}).get("survey_type") or "MWD", 40)

    mds     = [d for d in (_f(s.get("MD")) for s in stations) if d is not None]
    top_md  = min(mds) if mds else None
    base_md = max(mds) if mds else None

    try:
        capture(engine, HDR_TABLE, [{
            "dir_srvy_id":      sid,
            "survey_id":        sid,
            "survey_type":      styp,
            "survey_num":       1,
            "top_depth":        top_md,
            "base_depth":       base_md,
            "station_count":    len(stations),
            "depth_ouom":       "ft",
            "active_ind":       "Y",
            "row_created_by":   "DataWrangler",
            "row_created_date": ts,
        }], uwi=uwi, inventory_id=inv, source_path=sp, source=source)

        sta_rows = []
        for i, s in enumerate(stations, start=1):
            sta_rows.append({
                "dir_srvy_id":     sid,
                "survey_id":       sid,
                "station_id":      _uid(),
                "station_num":     i,
                "station_md":      _f(s.get("MD")),
                "inclination":     _f(s.get("INC")),
                "azimuth":         _f(s.get("AZI")),
                "station_tvd":     _f(s.get("TVD")),
                "ns_deviation":    _f(s.get("NS")),
                "ew_deviation":    _f(s.get("EW")),
                "dogleg_severity": _f(s.get("DLS")),
                "depth_ouom":      "ft",
                "active_ind":      "Y",
                "row_created_by":  "DataWrangler",
                "row_created_date": ts,
            })
        n = capture(engine, STA_TABLE, sta_rows,
                    uwi=uwi, inventory_id=inv, source_path=sp, source=source)
    except Exception as e:                       # noqa: BLE001
        return _result(errors=[str(e)])
    return _result(loaded=n, errors=[], survey_id=sid)
